    {
      "parameters": {
        "jsCode": "// Normalize Firecrawl search output into { title, link } items.\n// Handles: links array, data as array, data.{news,web} arrays, top-level {news,web}, or single result item.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  let results = [];\n\n  if (Array.isArray(j.links)) {\n    results = j.links;\n  } else if (Array.isArray(j.data)) {\n    results = j.data;\n  } else if (j.data && typeof j.data === 'object') {\n    results = [].concat(j.data.news || [], j.data.web || []);\n  } else if (Array.isArray(j.news) || Array.isArray(j.web)) {\n    results = [].concat(j.news || [], j.web || []);\n  } else if (j.title || j.url) {\n    results = [j];\n  }\n\n  for (const r of results) {\n    const title = r.title || (r.metadata && r.metadata.title) || '';\n    const link = r.url || r.link || '';\n    if (title) {\n      out.push({ json: { title, link } });\n    }\n  }\n}\n\nreturn out;"
      },
