      "parameters": {
        "jsCode": "const style = $('Analyze Reference Style').first().json.content || '';\nconst brand = $('IG Config').first().json.brand_name || 'QProperty';\nconst out = [];\nfor (const item of $input.all()) {\n  const title = item.json.title || \"\";\n  const prompt = `Buat grafik postingan Instagram yang bersih dan profesional untuk brand properti \"${brand}\" PERSIS dalam gaya visual berikut: ${style}. Orientasi potret 4:5. Selalu tampilkan nama brand \"${brand}\" dengan jelas dan terbaca di bagian atas gambar. Visualisasikan headline berita ini dalam BAHASA INDONESIA (terjemahkan ke Bahasa Indonesia bila perlu): \"${title}\". SEMUA teks pada gambar HARUS dalam Bahasa Indonesia dengan ejaan yang benar, tanpa teks acak atau gibberish. Sisakan ruang kosong yang cukup untuk overlay teks. Tanpa watermark.`;\n  out.push({ json: { title, imagePrompt: prompt } });\n}\nreturn out;"
      },
